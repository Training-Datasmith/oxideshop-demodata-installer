{
    "name": "oxid-esales/oxideshop-demodata-installer",
    "description": "This tool is used to copy pictures from demo data repository to OXID eShop, during setup process.",
    "license": "proprietary",
    "type": "oxideshop-component",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "OxidEsales\\DemoDataInstaller\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OxidEsales\\DemoDataInstaller\\Tests\\": "tests/",
            "OxidEsales\\EshopCommunity\\Internal\\Framework\\Edition\\": "tests/Stubs/OxidEsales/EshopCommunity/Internal/Framework/Edition/",
            "OxidEsales\\EshopCommunity\\Internal\\Framework\\Database\\": "tests/Stubs/OxidEsales/EshopCommunity/Internal/Framework/Database/",
            "OxidEsales\\EshopCommunity\\Internal\\Transition\\Utility\\": "tests/Stubs/OxidEsales/EshopCommunity/Internal/Transition/Utility/"
        }
    },
    "require-dev": {
        "doctrine/dbal": "^4.2.5",
        "phpunit/phpunit": "^11.5",
        "symfony/console": "^7.3",
        "symfony/filesystem": "^7.3"
    },
    "config": {
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    }
}
